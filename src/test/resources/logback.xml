<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- encoders are assigned the type
             ch.qos.logback.classic.encoder.PatternLayoutEncoder by default -->
        <encoder>
            <!-- Capped at 1000 chars: GitHub's runner stalls on long output lines (actions/runner#1031). -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %.-1000msg%n</pattern>
        </encoder>
    </appender>

    <root level="TRACE">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>